# =============================================================================
# VELTUX · Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# Sin las variables de Supabase la app arranca en MODO DEMOSTRACIÓN.
# =============================================================================

# --- Supabase (públicas: llegan al navegador; la seguridad la impone RLS) ----
# Local: valores que imprime `npm run db:start` (API URL y Publishable key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SECRETA: solo servidor, nunca con prefijo NEXT_PUBLIC_) -------
# Omite RLS. Solo para procesos de sistema (cola SMS, webhooks, tareas).
SUPABASE_SECRET_KEY=

# --- Aplicación ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integraciones futuras (no configurar todavía) -----------------------------
# Sprint 5-6 · Proveedor SMS (OTP y notificaciones)
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=VELTUX
# Sprint 9 · Stripe Billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
