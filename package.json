{
  "name": "veltux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --remote > src/types/database.types.ts",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
